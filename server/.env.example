# OpenRouter (agent model)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=anthropic/claude-haiku-4.5
# Max output tokens per model call (lower it if OpenRouter returns 402 "can only afford N tokens")
AGENT_MAX_TOKENS=8000

# First generations per account paid for by the key above. Later edits use the user's own key.
FREE_GENERATIONS=3
# Encrypts user API keys at rest. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_SECRET=

# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if your project still signs JWTs with the legacy HS256 secret.
# Projects using the newer asymmetric signing keys are verified via JWKS automatically.
SUPABASE_JWT_SECRET=

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
