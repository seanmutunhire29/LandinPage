# Serves the built SPA and proxies /api/* to the FastAPI container, so the whole app
# runs on one hostname. TLS terminates at Cloudflare, so plain HTTP here.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# WebContainers need a cross-origin isolated page (same headers as vite.config.js)
	header {
		Cross-Origin-Embedder-Policy credentialless
		Cross-Origin-Opener-Policy same-origin
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# /api/projects -> api:8000/projects (WebSockets included)
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv

		# Hashed build output can be cached forever; index.html must not be
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
