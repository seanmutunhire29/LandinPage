# Used by docker-compose.yml. API secrets live in server/.env.

# Zero Trust -> Networks -> Tunnels -> your tunnel -> the token in the install command
CLOUDFLARE_TUNNEL_TOKEN=

# Frontend build (baked into the JS bundle; the anon key is public by design)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Caddy in the web container proxies /api/* to the API, so it's the same hostname
VITE_API_URL=https://landinpage.infinityrecursion.net/api
